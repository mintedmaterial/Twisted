/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */

{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "twisted",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-12-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"images": {
		"binding": "IMAGES"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "twisted"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "twisted-newsletter",
			"database_id": "0463a12e-0924-4856-a8ba-42a0c94e8287",
			"migrations_dir": "./migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "ORDER_ASSETS",
			"bucket_name": "twisted-order-assets"
		},
		{
			"binding": "UGC_ASSETS",
			"bucket_name": "twisted-order-assets",
			"remote": true
		}
	],
	"ratelimits": [
		{ "name": "ORDER_INTENT_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
		{ "name": "ORDER_UPLOAD_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 12, "period": 60 } },
		{ "name": "ORDER_CHECKOUT_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 6, "period": 60 } }
	],
	"secrets": {
		"required": [
			"ORDER_ASSET_TOKEN_SECRET",
			"ORDER_INTENT_TOKEN_SECRET",
			"ORDER_MAINTENANCE_SECRET",
			"ORDER_REFERENCE_SECRET",
			"SQUARE_PRODUCTION_ACCESS_TOKEN",
			"TURNSTILE_SECRET_KEY"
		]
	},
	"vars": {
		"SQUARE_ENVIRONMENT": "production",
		"SQUARE_PRODUCTION_LOCATION_ID": "KMGV4Y657Z2A5",
		"TURNSTILE_ALLOWED_HOSTNAMES": "twistedcustomleather.com,www.twistedcustomleather.com",
		"DISCORD_WEBHOOK_URL": "",
		"CAMPAIGN_FROM_ADDRESS": "campaigns@twistedcustomleather.com"
	},
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": ["campaigns@twistedcustomleather.com"]
		}
	],
	"observability": {
		"enabled": true
	}
}
