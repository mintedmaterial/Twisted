/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */

{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "twisted",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-12-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"images": {
		"binding": "IMAGES"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "twisted"
		}
	],
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "twisted-newsletter",
			"database_id": "b3b64ce4-8731-4ffe-ab46-f66d722dbc2c",
			"migrations_dir": "./migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "UGC_ASSETS",
			"bucket_name": "twisted-order-assets",
			"remote": true
		}
	],
	"vars": {
		"DISCORD_WEBHOOK_URL": "",
		"CAMPAIGN_FROM_ADDRESS": "campaigns@twistedcustomleather.com"
	},
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": ["campaigns@twistedcustomleather.com"]
		}
	]
}
